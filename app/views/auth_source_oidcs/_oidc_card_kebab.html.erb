<div class="dropdown pull-right dropdown-kebab-pf">
  <button class="btn btn-link dropdown-toggle" type="button" id="dropupKebabOidc<%= auth_source.id %>" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    <span class="fa fa-ellipsis-v"></span>
  </button>
  <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="dropupKebabOidc<%= auth_source.id %>">
    <li><%= link_to_if_authorized _('Edit'), hash_for_edit_auth_source_oidc_path(:id => auth_source) %></li>
    <li><%= link_to_if_authorized _('Delete'), hash_for_auth_source_oidc_path(:id => auth_source),
            :method => :delete,
            :data => { :confirm => _("Are you sure you want to delete %s? You will need to restart Foreman after deletion.") % auth_source.name } %></li>
    <li role="separator" class="divider"></li>
    <li><%= link_to _('OIDC Documentation'), documentation_url("5.7ExternalAuthentication"), :rel => "external" %></li>
  </ul>
</div>
