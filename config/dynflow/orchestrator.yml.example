<%
  concurrency = ENV['FOREMAN_DYNFLOW_CONCURRENCY'].to_s.strip
  queues = ENV['FOREMAN_DYNFLOW_QUEUES'].to_s.strip
  queues = 'dynflow_orchestrator' if queues.empty?
  parsed_queues = queues.split(',').filter_map do |queue_str|
    queue, priority = queue_str.split('@', 2)
    queue = queue.to_s.strip
    next if queue.empty?

    [queue, [priority.to_s.to_i, 1].max]
  end
%>
:concurrency: <%= concurrency.empty? ? 1 : concurrency %>
:queues:
<% parsed_queues.each do |queue, priority| %>
  - - <%= queue %>
    - <%= priority %>
<% end %>
